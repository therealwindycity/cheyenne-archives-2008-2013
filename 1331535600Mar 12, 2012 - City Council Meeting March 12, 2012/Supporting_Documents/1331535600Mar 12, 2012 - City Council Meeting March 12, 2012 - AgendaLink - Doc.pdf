	<a href="https://www.cheyennecity.org/News-articles/The-Council-Chronicle-from-Council-President-Tom-Segrave-–-June-18-2026" class="profile-list item-0 homepage-show" >		
		
       <picture>
  <source media="(min-width: 992px)" srcset="/files/assets/public/v/1/stock/city-council-chambers.jpg?dimension=homepagelisting&w=380&h=242">
  <source media="(min-width: 768px)" srcset="/files/assets/public/v/1/stock/city-council-chambers.jpg?dimension=homepagelisting&w=496&h=315">
